# Copy this file to ".env" and fill in your values. Never commit .env to GitHub.

# Required: your MongoDB Atlas connection string (with your password filled in)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/
DB_NAME=releaseguard

# Required: GitHub fine-grained token, "Public repositories (read-only)"
GITHUB_TOKEN=

# Optional: any long random text. Use the same value in the GitHub webhook settings.
WEBHOOK_SECRET=

# Optional: the Production URL of your n8n Webhook node
N8N_WEBHOOK_URL=

# Optional: enables AI explanations (a built-in explanation is used without it)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Optional
MAX_COMMITS=30
PUBLIC_BASE_URL=
